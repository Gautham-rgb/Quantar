{
  "name": "quantar-lang",
  "displayName": "Quantar Language Support",
  "description": "Syntax and language-server support for Quantar files",
  "version": "1.0.1",
  "publisher": "Gauthamrgb",
  "author": "Gautham_rgb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gautham-rgb/Quantar"
  },
  "galleryBanner": {
    "color": "#10161F",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "extensionDependencies": [
    "ms-python.python",
    "ms-python.vscode-pylance"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "esbuild ./extension.js --bundle --platform=node --external:vscode --format=cjs --outfile=dist/extension.js",
    "vscode:prepublish": "npm run bundle",
    "package": "npm run bundle && npx @vscode/vsce package --no-dependencies",
    "publish": "npm run bundle && npx @vscode/vsce publish --no-dependencies"
  },
  "contributes": {
    "configuration": {
      "title": "Quantar",
      "properties": {
        "quantar.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Path to the Python interpreter that has Quantar and its LSP dependencies installed. Leave empty to use the project's .venv or the interpreter selected by the Python extension."
        }
      }
    },
    "configurationDefaults": {
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "quantarOperator": "#4FC1FF"
        }
      },
      "files.exclude": {
        "**/.quantar-pylance-mirrors/**": true
      },
      "search.exclude": {
        "**/.quantar-pylance-mirrors/**": true
      }
    },
    "languages": [
      {
        "id": "quantar",
        "aliases": [
          "Quantar",
          "quantar"
        ],
        "extensions": [
          ".qtr",
          ".quantar"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quantar",
        "scopeName": "source.quantar",
        "path": "./syntaxes/quantar.tmLanguage.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "quantarOperator",
        "superType": "operator",
        "description": "Quantar symbolic and word-based operators"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "quantar",
        "scopes": {
          "quantarOperator": [
            "keyword.operator.quantar"
          ]
        }
      }
    ]
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
