{
  "name": "quantar",
  "displayName": "Quantar",
  "description": "Quantar language support for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "quantar",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "quantar",
    "quantum",
    "python"
  ],
  "activationEvents": [
    "onLanguage:quantar"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quantar",
        "aliases": [
          "Quantar",
          "quantar"
        ],
        "extensions": [
          ".qtr"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quantar",
        "scopeName": "source.quantar",
        "path": "./syntaxes/quantar.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "quantar.runFile",
        "title": "Quantar: Run File"
      },
      {
        "command": "quantar.compileFile",
        "title": "Quantar: Compile File to Python"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "quantarOperator",
        "description": "Quantar operator"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "nullary",
        "description": "Nullary operator"
      },
      {
        "id": "unary",
        "description": "Unary operator"
      },
      {
        "id": "binary",
        "description": "Binary operator"
      },
      {
        "id": "ternary",
        "description": "Ternary operator"
      },
      {
        "id": "callable",
        "description": "Callable operator"
      },
      {
        "id": "matrix",
        "description": "Matrix or gate operator"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "quantar",
        "scopes": {
          "quantarOperator": [
            "keyword.operator.quantar"
          ],
          "quantarOperator.binary": [
            "keyword.operator.quantar"
          ],
          "quantarOperator.matrix": [
            "keyword.operator.quantar"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[quantar]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "Quantar",
      "properties": {
        "quantar.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Python interpreter used for the language server and runner."
        },
        "quantar.serverModule": {
          "type": "string",
          "default": "lang_systems.lsp",
          "description": "Python module used to start the Quantar language server."
        },
        "quantar.operatorModules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Python modules imported at language-server startup to register additional operators."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "package": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  }
}

