{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quantar",
  "scopeName": "source.quantar",
  "patterns": [
    {
      "include": "#quantar-operators"
    },
    {
      "include": "source.python"
    }
  ],
  "repository": {
    "quantar-operators": {
      "patterns": [
        {
          "name": "keyword.operator.quantar",
          "match": "<-i->|<-s->|<->"
        }
      ]
    }
  }
}
